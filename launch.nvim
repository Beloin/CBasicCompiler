{
  "version": "0.1.0",
  "configurations": [
    {
      "name": "Debug Compiler",
      "lang": "c",
      "type": "codelldb",
      "program": "./target",
      "pipeline": [
        "echo 'Hello World'",
        "make debug"
      ],
      "args": [
        "examples/flow-control/example_02.bc"
      ],
      "env": {
        "ENV_VAR": "My enviroment Variable 2"
      }
    },
    {
      "name": "Run Compiler",
      "lang": "c",
      "type": "codelldb",
      "program": "./target",
      "pipeline": [
        "make target"
      ],
      "args": [
        "examples/flow-control/example_02.bc"
      ],
      "env": {
        "ENV_VAR": "New enviroment"
      }
    }
  ],
  "tasks": [
    {
      "name": "Create compile_commands.json",
      "pipeline": [
        "bear -- make target"
      ]
    }
  ]
}
